# 多模态 RAG 知识库助手 — 环境配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# === LLM API（任意 OpenAI 兼容端点，非限定 DeepSeek） ===
# 支持 DeepSeek / 通义 / Kimi / 本地 vLLM 等一切 OpenAI 兼容服务。
# 也可以在应用启动后的「⚙ 设置入口」填写（可随时更改、热更新，无需重启）。
# 这里是占位示例，请替换为你的真实值；含密钥的 .env 已被 .gitignore 忽略。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_TEXT_MODEL=deepseek-chat
LLM_IMAGE_MODEL=deepseek-chat

# 本地视觉模型已废弃，识图统一走上面的 LLM_IMAGE_MODEL（视你的端点是否支持多模态而定）。

# === 服务配置 ===
HOST=0.0.0.0
PORT=8000

# === 安全 ===
# 速率限制（每分钟每用户最大请求数）
RATE_LIMIT_RPM=30
# 允许的来源（CORS），逗号分隔
CORS_ORIGINS=*

# === 数据库 ===
# ChromaDB 数据目录（默认: ./chroma_data）
CHROMA_PERSIST_DIR=./chroma_data
# SQLite 业务数据库路径（默认: ./data/knowledge_base.db）
SQLITE_DB_PATH=./data/knowledge_base.db

# === 内存管理 ===
# 最大内存占用（MB），超限触发淘汰策略
MAX_MEMORY_MB=6000
# 会话超时（分钟）
SESSION_TIMEOUT_MINUTES=60
